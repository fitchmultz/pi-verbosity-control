{
    "name": "@fitchmultz/pi-verbosity-control",
    "version": "0.6.4",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "index.ts",
        "README.md",
        "CHANGELOG.md"
    ],
    "description": "Per-model OpenAI verbosity control for Pi with optional native footer status",
    "keywords": [
        "pi-package",
        "pi",
        "pi-coding-agent",
        "openai",
        "verbosity"
    ],
    "author": "ferologics",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fitchmultz/pi-verbosity-control.git"
    },
    "homepage": "https://github.com/fitchmultz/pi-verbosity-control#readme",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "pi": {
        "extensions": [
            "index.ts"
        ]
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*"
    },
    "peerDependenciesMeta": {
        "@earendil-works/pi-ai": {
            "optional": true
        },
        "@earendil-works/pi-coding-agent": {
            "optional": true
        },
        "@earendil-works/pi-tui": {
            "optional": true
        }
    },
    "scripts": {
        "test": "node --test index.test.ts tests/quality-harness.test.ts",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --deny-warnings --ignore-pattern 'tests/probes/**' .",
        "lint:agent": "oxlint --deny-warnings --format=agent --ignore-pattern 'tests/probes/**' .",
        "lint:fix": "oxlint --fix --ignore-pattern 'tests/probes/**' .",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "policy:check": "node scripts/check-policy.ts",
        "quality:probes": "node --test tests/quality-harness.test.ts",
        "pack:check": "npm pack --dry-run",
        "check": "node scripts/run-gates.ts",
        "check:compat": "node scripts/run-gates.ts policy:check format:check lint typecheck test"
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "1.0.0",
        "@earendil-works/pi-coding-agent": "1.0.0",
        "@earendil-works/pi-tui": "1.0.0",
        "@types/node": "24.19.1",
        "@types/proper-lockfile": "4.1.4",
        "oxc-parser": "0.156.0",
        "oxfmt": "0.75.0",
        "oxlint": "1.90.0",
        "oxlint-tsgolint": "7.0.2005",
        "typescript": "7.0.2"
    },
    "dependencies": {
        "proper-lockfile": "4.1.2"
    }
}
