{
    "name": "pi-verbosity-control",
    "version": "0.5.1",
    "description": "Per-model OpenAI verbosity control for Pi with optional native footer status",
    "keywords": [
        "pi-package",
        "pi",
        "pi-coding-agent",
        "openai",
        "verbosity"
    ],
    "author": "ferologics",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fitchmultz/pi-verbosity-control.git"
    },
    "homepage": "https://github.com/fitchmultz/pi-verbosity-control#readme",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "pi": {
        "extensions": [
            "index.ts"
        ]
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*"
    },
    "peerDependenciesMeta": {
        "@earendil-works/pi-ai": { "optional": true },
        "@earendil-works/pi-coding-agent": { "optional": true },
        "@earendil-works/pi-tui": { "optional": true }
    },
    "scripts": {
        "test": "node --test index.test.ts",
        "typecheck": "tsc",
        "check:compat": "npm run typecheck && npm test"
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "0.87.1",
        "@earendil-works/pi-coding-agent": "0.87.1",
        "@earendil-works/pi-tui": "0.87.1",
        "@types/node": "24.19.0",
        "@types/proper-lockfile": "4.1.4",
        "typescript": "7.0.2"
    },
    "dependencies": {
        "proper-lockfile": "4.1.2"
    }
}
