{
    "name": "pi-verbosity-control",
    "version": "0.3.0",
    "description": "Per-model OpenAI verbosity control for Pi with optional inline footer display",
    "keywords": [
        "pi-package",
        "pi",
        "pi-coding-agent",
        "openai",
        "verbosity"
    ],
    "author": "ferologics",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ferologics/pi-verbosity-control.git"
    },
    "homepage": "https://github.com/ferologics/pi-verbosity-control#readme",
    "bugs": {
        "url": "https://github.com/ferologics/pi-verbosity-control/issues"
    },
    "pi": {
        "extensions": [
            "index.ts"
        ]
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*"
    },
    "scripts": {
        "test": "vitest run --configLoader native",
        "typecheck": "tsc --noEmit",
        "check:compat": "npm run typecheck && npm test"
    },
    "devDependencies": {
        "@earendil-works/pi-ai": "0.86.1",
        "@earendil-works/pi-coding-agent": "0.86.1",
        "@earendil-works/pi-tui": "0.86.1",
        "@types/node": "24.12.4",
        "typescript": "5.9.3",
        "vitest": "4.1.9"
    },
    "piRelease": {
        "repo": "ferologics/pi-verbosity-control",
        "branch": "main",
        "subtreePublishRecipe": "publish-pi-verbosity-control"
    }
